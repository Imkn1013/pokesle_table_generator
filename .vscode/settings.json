    "activityBar.activeBorder":"#1d1e22",
    "tab.activeBackground":"#ffffff",
    "tab.activeForeground":"#1d1e22",
    "tab.inactiveBackground":"#cccccc",
    "tab.inactiveForeground":"#1d1e22",
    "tab.hoverBackground":"#cccccc",
    "tab.hoverForeground":"#1d1e22",
    "editorGroupHeader.tabsBackground":"#cccccc",
    "breadcrumb.background":"#ffffff",
    "breadcrumb.foreground":"#1d1e22",
    "editorGroupHeader.tabsBorder":"#ffffff",
    "tab.unfocusedActiveBackground":"#ffffff",
    "tab.unfocusedActiveForeground":"#1d1e22",
    "tab.unfocusedInactiveBackground":"#cccccc",
