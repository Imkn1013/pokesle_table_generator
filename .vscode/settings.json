    "editorGroupHeader.noTabsBackground":"#cccccc",
    "editorGroupHeader.noTabsBorder":"#ffffff",
    "editorGroupHeader.noTabsForeground":"#1d1e22"//*/
  },
  "editor.semanticTokenColorCustomizations": {
    "enabled": true, // セマンティックハイライトを有効化
    "rules": {
        // 「自分で定義した関数」の色
        "function.declaration": "#809bbd", 
        
        // 「既存の関数やライブラリの関数（標準メソッドなど）」
        // これらは 'defaultLibrary' という修飾子がつきます
        "function.defaultLibrary": "#9a8297",
        
        // 実行中の関数（呼び出し側）を区別する場合
        "function": "#ddca7e"
    }
  },
  "editor.tokenColorCustomizations": { "textMateRules": 
