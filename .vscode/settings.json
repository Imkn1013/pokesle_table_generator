{
  //"workbench.colorTheme": "Dark+",
  "editor.hover.enabled": "off", // ホバーを無効化
  "editor.occurrencesHighlight": "off", // カーソル位置と同じ単語のハイライトをオフ
  "editor.selectionHighlight": false,     // 選択した部分と同じ箇所のハイライトをオフ
  "editor.bracketPairColorization.enabled": false, // 括弧のペアの色付けを無効化
  "workbench.colorCustomizations":{
    "foreground": "#cccccc",
    "editor.background": "#1d1e22",
    /*"titleBar.activeBackground":"#ffffff",
    "titleBar.activeForeground":"#1d1e22",
